{
  "name": "security-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "Local API security testing workbench — desktop + CLI, engine-first architecture",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "dev:desktop": "pnpm --filter @sw/desktop dev",
    "dev:cli": "pnpm --filter @sw/cli dev",
    "tauri:dev": "pnpm --filter @sw/desktop tauri:dev",
    "tauri:build": "pnpm --filter @sw/desktop tauri:build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm build && node --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "lint": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=22.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
